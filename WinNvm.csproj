<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WinNvm</RootNamespace>
    <AssemblyName>WinNvm</AssemblyName>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Description>Node Version Manager for Windows</Description>
    <Company>WinNvm</Company>
    <Product>WinNvm</Product>
    <Copyright>Copyright © 2025</Copyright>
  </PropertyGroup>

  <!-- Settings applied when publishing as a single file -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
